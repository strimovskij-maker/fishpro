<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FishPro Ukraine</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #0f172a;
  color: white;
}

header {
  background: #111827;
  padding: 20px;
  position: fixed;
  width: 100%;
  top: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1000;
}

nav a {
  color: white;
  margin: 0 15px;
  text-decoration: none;
  transition: 0.3s;
}

nav a:hover {
  color: #38bdf8;
}

section {
  padding: 100px 20px;
  min-height: 100vh;
}

.hero {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e') center/cover;
  text-align: center;
}

.hero h1 {
  font-size: 3em;
  background: rgba(0,0,0,0.6);
  padding: 20px;
  border-radius: 10px;
}

.btn {
  margin-top: 20px;
  padding: 12px 25px;
  background: #38bdf8;
  border: none;
  color: black;
  cursor: pointer;
  transition: 0.3s;
  border-radius: 8px;
}

.btn:hover {
  transform: scale(1.1);
}

.products {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 20px;
}

.card {
  background: #1f2937;
  padding: 20px;
  border-radius: 12px;
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-10px);
  box-shadow: 0 0 20px #38bdf8;
}

footer {
  background: #111827;
  text-align: center;
  padding: 20px;
}

@media(max-width:768px){
  nav {
    display: flex;
    flex-direction: column;
  }
}
</style>
</head>

<body>

<header>
<h2>FishPro Ukraine</h2>
<nav>
<a href="#home" data-ua="Головна" data-en="Home">Home</a>
<a href="#catalog" data-ua="Каталог" data-en="Catalog">Catalog</a>
<a href="#sales" data-ua="Акції" data-en="Sales">Sales</a>
<a href="#blog" data-ua="Блог" data-en="Blog">Blog</a>
<a href="#reviews" data-ua="Відгуки" data-en="Reviews">Reviews</a>
<a href="#contact" data-ua="Контакти" data-en="Contact">Contact</a>
</nav>
</header>

<section class="hero" id="home">
<h1 data-ua="Професійні рибальські снасті" data-en="Professional Fishing Gear">
Professional Fishing Gear
</h1>
<button class="btn" data-ua="Перейти до каталогу" data-en="Go to Catalog">
Go to Catalog
</button>
</section>

<section id="catalog">
<h2 data-ua="Каталог товарів" data-en="Product Catalog">Product Catalog</h2>
<div class="products">
<div class="card"><h3>Carbon Rod</h3><p>$120</p></div>
<div class="card"><h3>Spinning Reel</h3><p>$85</p></div>
<div class="card"><h3>Fishing Lures Set</h3><p>$45</p></div>
<div class="card"><h3>Fishing Backpack</h3><p>$60</p></div>
</div>
</section>

<section id="sales">
<h2 data-ua="Акції" data-en="Sales">Sales</h2>
<p data-ua="Знижка 20% на всі котушки!" data-en="20% discount on all reels!">
20% discount on all reels!
</p>
</section>

<section id="blog">
<h2 data-ua="Блог про риболовлю" data-en="Fishing Blog">Fishing Blog</h2>
<p data-ua="Корисні поради для початківців та професіоналів."
data-en="Useful tips for beginners and professionals.">
Useful tips for beginners and professionals.
</p>
</section>

<section id="reviews">
<h2 data-ua="Відгуки клієнтів" data-en="Customer Reviews">Customer Reviews</h2>
<p>"Great quality and fast delivery!"</p>
</section>

<section id="contact">
<h2 data-ua="Контакти" data-en="Contact">Contact</h2>
<p>Email: fishpro@email.com</p>
<p>Phone: +380 00 000 0000</p>
</section>

<footer>
<p>© 2026 FishPro Ukraine</p>
</footer>

<script>
const userLang = navigator.language || navigator.userLanguage;
const elements = document.querySelectorAll("[data-ua]");

if(userLang.startsWith("uk")){
  elements.forEach(el => el.textContent = el.getAttribute("data-ua"));
} else {
  elements.forEach(el => el.textContent = el.getAttribute("data-en"));
}
</script>

</body>
</html>
